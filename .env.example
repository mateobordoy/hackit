# Copy to .env (never commit it). Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
# The team key from https://arena.tacto.ai/apply. One per team; never commit, log or post it.
ARENA_API_KEY=
# The unpacked data package (`buyer data` puts it here, the Sunday release next to it)
ARENA_DATA=data/package

# Optional: a model that writes one polite paragraph per e-mail. Leave LLM_MODEL empty to run on
# templates only (the agent decides everything in code either way).
# LLM_PROVIDER=anthropic          # needs: pip install -e .[anthropic]
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai             # any OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_API_KEY=
