# Copy to .env and fill in. Never commit .env. Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
# The team key from https://arena.tacto.ai/apply (one per team; never commit, log or post it)
ARENA_API_KEY=
# The unpacked data package (`uv run arena data`; re-run Sunday 08:00 for the release)
ARENA_DATA=data/package

# The model (Anthropic)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=

# Hard cap on model spend in EUR, shared by every process using the same spend file
HACKIT_BUDGET_EUR=30
# HACKIT_SPEND_FILE=logs/spend.json

# Watch UI (`hackit2 gui`): the reference run's scores for the Scores view, a run manifest (.json)
# or a comparison digest (.md); without it, logs/compare/digest.md is used
# HACKIT_REFERENCE_FILE=
